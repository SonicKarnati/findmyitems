accessWidener	v2	official

# Read the GUI origin of any container screen so the search overlay can be
# positioned over individual slots without a mixin.
accessible	field	net/minecraft/client/gui/screens/inventory/AbstractContainerScreen	leftPos	I
accessible	field	net/minecraft/client/gui/screens/inventory/AbstractContainerScreen	topPos	I

# Read the currently-bound key of a KeyMapping so the config screen can show it.
accessible	field	net/minecraft/client/KeyMapping	key	Lcom/mojang/blaze3d/platform/InputConstants$Key;

# Build one render type: vanilla's line pipeline with the depth test always passing, so a
# highlighted chest is visible through walls. Both of these are how vanilla builds its own
# line types; neither is exposed publicly.
accessible	field	net/minecraft/client/renderer/RenderPipelines	LINES_SNIPPET	Lcom/mojang/blaze3d/pipeline/RenderPipeline$Snippet;
accessible	method	net/minecraft/client/renderer/rendertype/RenderType	create	(Ljava/lang/String;Lnet/minecraft/client/renderer/rendertype/RenderSetup;)Lnet/minecraft/client/renderer/rendertype/RenderType;
